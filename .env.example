# Copy to `.env` in the repo root and fill in real values. Never commit `.env`.
#
# ADMIN_* are used on **first boot only** (hashed into SQLite `admin_credentials`).
# After initialization, SQLite is the sole authority — changing these will NOT
# overwrite an existing admin. Change password in Admin → 站点设置 → 安全设置.
# Password rule: 6–18 characters (no trim/truncate; blank rejected; UTF-8 ≤72 bytes).
# Production: both required when no admin row exists — weak defaults are NOT auto-created.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cookie session encryption secret (min 32 characters). Required.
SESSION_SECRET=

# App port (host → container maps HOST:3000)
PORT=3000

# Cookie Secure flag. Use true behind HTTPS; false only for plain HTTP labs.
COOKIE_SECURE=true

# SQLite path inside the container (bind mount ./data → /data)
DATABASE_PATH=/data/linknest.db

# Opt-in Server-Timing on admin GET list routes (off by default).
# ENABLE_SERVER_TIMING=true
