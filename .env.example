# Copy to `.env` in the repo root. Never commit `.env`.
#
# Defaults below are for first-boot / quick deploy only — NOT a secure production
# configuration. After first login, change the admin password in
# Admin → 站点设置 → 安全设置. Once an admin row exists in SQLite, changing
# ADMIN_* here will NOT overwrite it.
#
# Password rule: 6–18 characters (no trim/truncate; blank rejected; UTF-8 ≤72 bytes).
# Public deploy: replace SESSION_SECRET; set COOKIE_SECURE=true behind HTTPS.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# Cookie session encryption secret (exactly 32 characters in this example).
# Replace for any public/production deployment.
SESSION_SECRET=0123456789abcdef0123456789abcdef

# App port (host → container maps HOST:3000)
PORT=3000

# Pre-built container image (GitHub Actions → GHCR). Server deploy: pull this, do not build.
# LINKNEST_IMAGE=ghcr.io/iafan7/afan-nav:latest
# Pin a release: LINKNEST_IMAGE=ghcr.io/iafan7/afan-nav:v1.0.0

# Cookie Secure flag. false for plain HTTP labs; must be true behind HTTPS.
COOKIE_SECURE=false

# SQLite path inside the container (bind mount ./data → /data)
DATABASE_PATH=/data/linknest.db

# Opt-in Server-Timing on admin GET list routes (off by default).
# ENABLE_SERVER_TIMING=true
